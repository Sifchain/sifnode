{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cloudProvider", "image", "chain", "genesis", "persistence", "service"],
  "properties": {
    "cloudProvider": {"type": "string", "enum": ["aws", "azure"]},
    "image": {
      "type": "object", "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "chain": {
      "type": "object", "required": ["id", "moniker"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "moniker": {"type": "string", "minLength": 1},
        "persistentPeers": {"type": "string"},
        "externalAddress": {"type": "string"},
        "minimumGasPrices": {"type": "string"}
      }
    },
    "genesis": {
      "type": "object",
      "oneOf": [
        {"required": ["existingConfigMap"], "properties": {
          "existingConfigMap": {"type": "string", "minLength": 1},
          "existingClaim": {"type": "string", "maxLength": 0}
        }},
        {"required": ["existingClaim"], "properties": {
          "existingConfigMap": {"type": "string", "maxLength": 0},
          "existingClaim": {"type": "string", "minLength": 1}
        }}
      ],
      "properties": {
        "existingConfigMap": {"type": "string"},
        "existingClaim": {"type": "string"}
      }
    },
    "persistence": {
      "type": "object", "required": ["size"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "existingClaim": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "properties": {"type": {"enum": ["LoadBalancer", "ClusterIP", "NodePort"]}}
    }
  }
}
